NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=database/personality.sqlite
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CHAT_TOKEN_SECRET=
# Chat stays unavailable until both values and the SDK are present.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=800
# Leave unset for direct local access. Set only to a trusted proxy IP/subnet.
TRUST_PROXY=
