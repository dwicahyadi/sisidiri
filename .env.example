# Salin melalui npm run setup; .env yang sudah ada tidak akan ditimpa.
NODE_ENV=development
HOST=127.0.0.1
# Ganti jika port ini digunakan proyek lain.
PORT=3000
DATABASE_PATH=database/personality.sqlite
# npm run setup membuat secret acak. Untuk membuat manual:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CHAT_TOKEN_SECRET=
# Isi key milik sendiri dan model yang tersedia di akun Gemini.
# Chat memerlukan key, model, dan SDK @google/genai.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=800
# Kosongkan untuk akses lokal langsung; isi hanya IP/subnet proxy tepercaya.
TRUST_PROXY=
