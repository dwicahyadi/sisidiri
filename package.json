{
  "name": "sisidiri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kuis kepribadian SisiDiri berdasarkan teori MBTI, dengan chat AI Gemini.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env src/server.js",
    "build": "node scripts/build.mjs",
    "db:seed": "node --env-file-if-exists=.env database/seed.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "assets:optimize": "python3 scripts/optimize-assets.py"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "express": "5.1.0",
    "zod": "4.3.5"
  },
  "optionalDependencies": {
    "@google/genai": "2.28.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.18"
  }
}
