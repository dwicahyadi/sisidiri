# Salin melalui npm run setup; .env yang sudah ada tidak akan ditimpa.
NODE_ENV=development
HOST=127.0.0.1
# Ganti jika port ini digunakan proyek lain.
PORT=3000
DATABASE_PATH=database/personality.sqlite
# npm run setup membuat secret acak. Untuk membuat manual:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CHAT_TOKEN_SECRET=
# Isi key milik sendiri dan model yang tersedia di akun Gemini.
# Chat memerlukan key, model, dan SDK @google/genai.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=800
# Kosongkan untuk akses lokal langsung; isi hanya IP/subnet proxy tepercaya.
TRUST_PROXY=

# Origin publik utama, tanpa path. Isi pada environment Production Vercel.
# Jika kosong di Vercel, memakai VERCEL_PROJECT_PRODUCTION_URL.
SITE_URL=
# Aktifkan juga Web Analytics di dashboard Vercel, lalu redeploy.
VERCEL_ANALYTICS_ENABLED=false
# Matikan chat tanpa mematikan kuis bila kuota/biaya AI perlu dibatasi.
CHAT_ENABLED=true
# Wajib di produksi/Vercel, opsional lokal. Gunakan database yang sama pada semua instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Batas global percobaan panggilan AI per hari UTC, termasuk kegagalan provider.
CHAT_DAILY_LIMIT=200

# Opsional: nilai content dari HTML tag Google Search Console (bukan API key).
GOOGLE_SITE_VERIFICATION=
